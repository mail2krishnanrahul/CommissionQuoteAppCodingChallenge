# Copy to .env (git-ignored) or export these in your shell. Every value here is a safe placeholder.
# With the `local` Spring profile you need none of them: both modules fall back to the fake key
# `local-dev-key-not-a-secret`.

# ---- quote-app (port 8080) ----
# Port the web app listens on.
SERVER_PORT=8080
# Where the Commission Quote API lives. Point this at the real vendor later; no code change needed.
VENDOR_BASE_URL=http://localhost:8081
# Shared secret sent in the `api-key` header. REQUIRED outside the `local` profile; load it from a secrets manager in real environments.
VENDOR_API_KEY=replace-me
# TCP connect timeout per attempt.
VENDOR_CONNECT_TIMEOUT=1s
# Read timeout per attempt.
VENDOR_READ_TIMEOUT=2s
# Retries after the first attempt for 5xx, timeouts and connection failures (0 disables retry).
VENDOR_MAX_RETRIES=1
# First retry delay; doubles per retry, with jitter.
VENDOR_RETRY_BACKOFF=200ms

# ---- vendor-mock (port 8081) ----
# SERVER_PORT is shared by name: set it per process if you override it (e.g. SERVER_PORT=8081 for the mock).
# Comma-separated accepted keys, so a key can be rotated with an overlap window. Must include VENDOR_API_KEY.
MOCK_API_KEYS=replace-me
# Turn simulated failures and latency on or off.
MOCK_CHAOS_ENABLED=true
# Probability (0-1) that an authenticated call fails with a random 500 or 503.
MOCK_CHAOS_FAILURE_RATE=0.2
# Probability (0-1) that a call waits MOCK_CHAOS_SLOW_DELAY before answering. failure + slow must be <= 1.
MOCK_CHAOS_SLOW_RATE=0.05
# How long a "slow" call waits; keep it above the app's read timeout to exercise the timeout path.
MOCK_CHAOS_SLOW_DELAY=5s
# Honour the X-Mock-Scenario: ok|error|slow request header to force an outcome (handy for demos).
MOCK_CHAOS_SCENARIO_HEADER=true
